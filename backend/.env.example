# PostgreSQL (async). Plain postgresql:// is rewritten to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://USER:PASS@127.0.0.1:5432/project_llm

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

ADMIN_API_KEY=change-me-admin-key

# HS256 secret for dashboard JWT (must match frontend JWT_SECRET)
JWT_SECRET=change-me-long-random-string
# Optional; default 168 (7 days)
# JWT_EXPIRE_HOURS=168

# CORS for browser clients (comma-separated origins or *)
CORS_ORIGINS=*
