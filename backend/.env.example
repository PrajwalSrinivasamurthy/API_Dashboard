# Microsoft SQL Server — async via ODBC (install "ODBC Driver 18 for SQL Server" + aioodbc).
# URL-encode special characters in the password (e.g. @ -> %40).
# Typical Azure / TLS: add &Encrypt=yes&TrustServerCertificate=no (or yes for dev-only).
DATABASE_URL=mssql+aioodbc://USER:PASSWORD@HOST:1433/DATABASE?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1

ADMIN_API_KEY=change-me-admin-key

# HS256 secret for dashboard JWT (must match frontend JWT_SECRET)
JWT_SECRET=change-me-long-random-string
# Dashboard JWT lifetime (hours); also used for virtual-key reveal link expiry. Default 5.
# JWT_EXPIRE_HOURS=5

# CORS for browser clients (comma-separated origins or *)
CORS_ORIGINS=*

# Optional: Microsoft Teams Incoming Webhook URL — alerts on wrong-IP usage and budget threshold.
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...

# Request auth hardening
# ENABLE_IP_CHECK=false
# ENABLE_HMAC_CHECK=true
# Shared secret used with project key for HMAC-SHA256 request signatures.
# HMAC_SIGNING_SECRET=change-me-hmac-secret
# HMAC_MAX_SKEW_SECONDS=300
# HMAC_NONCE_TTL_SECONDS=600

# Per-key defaults: $25 budget (column budget_usd); spike = rolling window on usage_logs.
# SPIKE_WINDOW_SECONDS=60
# SPIKE_MAX_COST_USD=5
# SPIKE_MAX_TOKENS=500000
# SPIKE_MAX_REQUESTS=120
# BUDGET_THRESHOLD_FRACTION=0.8

# Logging (under backend/). dev.log = app + SQLAlchemy/httpx noise control; audit.log = one JSON line per IT event.
# LOG_TO_FILES=true
# LOG_DIR=logs
# DEV_LOG_FILE=dev.log
# AUDIT_LOG_FILE=audit.log
# LOG_LEVEL=INFO
