# FastAPI base URL (no trailing slash) — same host/port as uvicorn
BACKEND_URL=http://127.0.0.1:8000

# Must match backend/.env ADMIN_API_KEY exactly (server-only; never in the browser bundle)
ADMIN_API_KEY=admin

# Same value as backend JWT_SECRET — used to verify dashboard session cookies (server + middleware)
JWT_SECRET=change-me-long-random-string
