# Copy to .env in repo root (used by docker compose variable substitution)

OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_BASE_URL=https://api.openai.com/v1

ADMIN_API_KEY=admin
JWT_SECRET=change-me-long-random-string
JWT_EXPIRE_HOURS=5

# SQL Server container credentials (used only when DATABASE_URL is not set)
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
# URL-encoded variant for the default DATABASE_URL (replace @ with %40, etc.)
MSSQL_SA_PASSWORD_URLENC=YourStrong%40Passw0rd
MSSQL_DB_NAME=master

# Optional: full async ODBC URL for a remote SSMS / Azure SQL database.
# If set, the backend container uses this and you can ignore MSSQL_* above for DB host.
# URL-encode special characters in the password (e.g. @ -> %40).
# DATABASE_URL=mssql+aioodbc://USER:PASSWORD@your-server.database.windows.net:1433/yourdb?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# Optional extras
# TEAMS_WEBHOOK_URL=
# CORS_ORIGINS=*
# ENABLE_IP_CHECK=false
# ENABLE_HMAC_CHECK=true
# HMAC_SIGNING_SECRET=change-me-hmac-secret
# HMAC_MAX_SKEW_SECONDS=300
# HMAC_NONCE_TTL_SECONDS=600
